# n8n self-hosted on DigitalOcean — copy to .env and fill. NEVER commit .env.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=            # long random string
POSTGRES_DB=n8n_main

GENERIC_TIMEZONE=Europe/Madrid

# The public hostname n8n believes it is reachable at. Every webhook URL is
# built from this, so set it before the first workflow is created.
N8N_HOST=n8n.yourdomain.com

# Set ONCE, before first boot, 32+ random characters.
# n8n encrypts stored credentials with this key. Change it later and every
# saved credential becomes unreadable.
N8N_ENCRYPTION_KEY=
